<html>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Organization Verification</title>
  </head>
  <body style='margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f7f7f7;'>
    <table width='100%' cellpadding='0' cellspacing='0' style='padding: 20px;'>
      <tr>
        <td align='center'>
          <table width='600' style='background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.1);'>
            <!-- Header -->
            <tr>
              <td style='background-color: #007bff; padding: 20px; text-align: center; color: #ffffff; font-size: 24px; font-weight: bold;'>
                Verify Your Organization
              </td>
            </tr>

            <!-- Message Body -->
            <tr>
              <td style='padding: 20px; color: #333333; font-size: 16px; line-height: 1.5;'>
                <p>Hi,</p>
                <p>
                  Thank you for registering your organization with EngageGPT. To complete the verification process and activate your organization, please click the button below:
                </p>

                <p style='text-align: center; margin: 20px 0;'>
                  <a
                    href='{{verificationURL}}'
                    style='display: inline-block; background-color: #007bff; color: #ffffff; text-decoration: none; padding: 10px 20px; border-radius: 5px; font-size: 16px;'
                  >
                    Verify Organization
                  </a>
                </p>

                <p>
                  If you did not initiate this registration, please disregard this email or contact our support team.
                </p>

                <p>
                  This link will expire in
                  <strong>10 mins</strong>
                  for security reasons.
                </p>
              </td>
            </tr>

            <!-- Fallback Link -->
            <tr>
              <td style='background-color: #f1f1f1; padding: 10px; text-align: center; color: #888888; font-size: 14px;'>
                <p>
                  If the button above doesn't work, copy and paste the following link into your browser:
                </p>
                <p style='word-wrap: break-word; color: #007bff;'>
                  {{verificationURL}}
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style='background-color: #007bff; padding: 10px; text-align: center; color: #ffffff; font-size: 12px;'>
                <p>EngageGPT - AI for LinkedIn</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>