<html>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>{{subject}}</title>
    <style>
      body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f7f7f7; margin: 0; padding: 0; } .email-container {
      max-width: 600px; margin: 30px auto; background-color: #fff;
      border-radius: 10px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1); overflow:
      hidden; } .header { background-color:
      {{#if isSuccess}}#28a745{{else}}#dc3545{{/if}}; color: #ffffff; padding:
      20px; text-align: center; font-size: 22px; font-weight: bold; } .content {
      padding: 20px; font-size: 16px; color: #333; line-height: 1.6; }
      .post-details { background-color: #f1f5f9; padding: 15px; border-radius:
      8px; margin-top: 15px; white-space: pre-line; } .post-details p { margin:
      8px 0; } .content a.button { display: inline-block; margin-top: 20px;
      background-color: #0d6efd; color: white; text-decoration: none; padding:
      12px 24px; border-radius: 6px; font-weight: bold; text-align: center; }
      .footer { background-color: #f1f1f1; padding: 15px; text-align: center;
      font-size: 14px; color: #888; }
    </style>
  </head>
  <body>
    <div class='email-container'>
      <div class='header'>{{subject}}</div>
      <div class='content'>
        <p>{{#if isSuccess}}Your LinkedIn post has been published successfully.{{else}}There
            was an issue posting your LinkedIn content.{{/if}}</p>

        <div class='post-details'>
          <p><strong>📝 Content:</strong><br />{{post.content}}</p>
          <p><strong>📅 Date:</strong> {{post.postDate}}</p>
          <p><strong>⏰ Time:</strong> {{post.postTime}}</p>
        </div>

        {{#if isSuccess}}
          <a
            class='button'
            href='https://www.linkedin.com/feed/update/{{post.postId}}'
          >View Post on LinkedIn</a>
        {{else}}
          <p><strong>⚠️ Error Details:</strong> {{errorMessage}}</p>
        {{/if}}
      </div>
      <div class='footer'>
        EngageGPT - AI for LinkedIn |
        <a href='https://engagegpt.in'>engagegpt.in</a>
      </div>
    </div>
  </body>
</html>