<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>EngageGPT 3.1 is Here</title>
  </head>
  <body style="background-color: #f4f4f5; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

    <table width='100%' style='background-color: #f4f4f5; padding: 40px 10px;'>
      <tr>
        <td align='center'>

          <table width='600' style='background-color: #ffffff; border-radius: 16px; overflow: hidden;'>

            <!-- HEADER -->
            <tr>
              <td align='center' style='background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); padding: 50px 40px;'>
                <h2 style='color: #c7d2fe; margin: 0; font-size: 14px;'>EngageGPT</h2>
                <h1 style='color: #ffffff; margin: 10px 0 0; font-size: 32px;'>Welcome to 3.1</h1>
                <p style='color: #e0e7ff; margin-top: 10px;'>Smarter, faster, and more powerful.</p>
              </td>
            </tr>

            <!-- BODY -->
            <tr>
              <td style='padding: 40px;'>

                <p style='font-size: 16px; color: #333;'>Hi {{#if name}}{{name}}{{else}}there{{/if}},</p>

                <!-- FEATURE -->
                <div style='background:#f8fafc; padding:20px; border-radius:12px; margin-bottom:25px;'>
                  <h3 style='margin:0; font-size:18px;'>🚀 Version 3.1 is Now Live</h3>
                  <p style='margin-top:10px; font-size:15px; color:#555;'>
                    We’re excited to announce that EngageGPT 3.1 is now available!
                  </p>
                  <p style='font-size:15px; color:#555;'>
                    The second biggest challenge has officially been resolved — you can now
                    <strong>comment on LinkedIn directly using EngageGPT</strong>.
                  </p>
                  <p style='font-size:15px; color:#555;'>
                    Thank you for your patience and support while we worked on this.
                  </p>
                </div>

                <!-- CREDIT MESSAGE -->
                <div style='margin-bottom:30px;'>
                  <p style='font-size:15px; color:#555;'>
                    If you faced any issues earlier and lost credits, just reply to this email. We’ll restore your credits and add
                    <strong>200 free credits</strong>
                    from our side.
                  </p>
                </div>

                <!-- CTA -->
                <div style='text-align:center; margin-bottom:30px;'>
                  <a href='https://www.linkedin.com/feed/' style='background:#0f172a; color:#fff; padding:14px 30px; text-decoration:none; border-radius:8px; font-weight:600;'>
                    Explore EngageGPT 3.1
                  </a>
                </div>

                <!-- SUPPORT -->
                <div style='border-top:1px solid #eee; padding-top:20px;'>
                  <p style='font-size:15px; color:#555;'>
                    Need help? Reach out to us:
                  </p>
                  <p style='font-size:15px;'>
                    <a href='mailto:bharat.pahwa@engagpt.in'>bharat.pahwa@engagegpt.in</a><br />
                    <a href='mailto:support@engagegpt.in'>support@engagegpt.in</a>
                  </p>

                  <p style='margin-top:20px;'>
                    Best regards,<br />
                    <strong>EngageGPT Team</strong>
                  </p>
                </div>

              </td>
            </tr>

            <!-- FOOTER -->
            <tr>
              <td align='center' style='background:#f8fafc; padding:20px;'>
                <p style='font-size:12px; color:#999;'>
                  ©
                  {{year}}
                  EngageGPT. All rights reserved.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>