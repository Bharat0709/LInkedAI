            </tr>

            <tr>
              <td align='center' style='background:#f8fafc; padding:30px; border-top: 1px solid #e2e8f0;'>
                <p style='font-size:12px; color:#94a3b8; margin: 0;'>
                  ©
                  {{year}}
                  EngageGPT. AI for LinkedIn
                </p>
