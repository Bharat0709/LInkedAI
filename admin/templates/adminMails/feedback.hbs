<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Feedback</title>
    <style>
      body { font-family: Arial, sans-serif; line-height: 1.6; background-color: #f4f4f4; color: #333; padding: 20px; } .container { max-width: 600px; margin: auto; background: #ffffff; padding: 20px; border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1); } h1 { color: #555; } .credits-info { margin-top: 20px; padding: 10px; background-color: #e8f0fe; border-left: 4px solid #007bff; }
    </style>
  </head>
  <body>
    <div class='container'>
      <h1>{{name}} Rated {{rating}} Stars</h1>
      <p>Here are the user's details:</p>
      <p><strong>Email:</strong> {{email}}</p>
      <p>{{name}} rated <strong>{{rating}}</strong> Stars</p><br />

      <div class='credits-info'>
        <p>Feedback <br /> {{feedback}}</p>
      </div>
    </div>
  </body>
</html>